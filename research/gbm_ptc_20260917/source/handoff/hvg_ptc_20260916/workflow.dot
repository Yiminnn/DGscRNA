digraph DGscRNA {
 graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.28", ranksep="0.38", splines=polyline,
        fontname="DejaVu Sans", fontsize=18, labelloc=t,
        label="DG-scRNA: feature ablations through terminal annotation\nGBM experiment design | Reference labels enter evaluation only"];
 node [shape=box, style="rounded,filled", fillcolor="#F3F6F8", color="#52616B", penwidth=1.2,
       fontname="DejaVu Sans", fontsize=10, margin="0.15,0.10"];
 edge [color="#52616B", arrowsize=0.65, fontname="DejaVu Sans", fontsize=9];

 input [label="Frozen author-QC cells\n121 GBM samples / 59 patients\nGene filter: detected in at least 3 cells", fillcolor="#E8F1F8"];
 counts [label="Raw integer counts\nNo reference annotations in fitting objects"];
 normalize [label="Normalize to 10,000 counts; log1p\nScale each gene; clip at 10"];
 features [label="A1  |  Geometry feature set\nAll genes; HVG 500 / 1k / 2k / 3k / 5k\nVST on counts; legacy dispersion bridge\nA5: HVG2000 + marker-gene union", color="#C97912", fillcolor="#FFF1DA", penwidth=1.8];
 pre [shape=diamond, label="A2  |  Pre-PCA?", color="#C97912", fillcolor="#FFF1DA"];
 pca [label="PCA30 (ARPACK)", color="#C97912", fillcolor="#FFF1DA"];
 dr [label="A3  |  Representation\nPrimary: PCA / FA / ICA / Isomap / UMAP / t-SNE (2D), or no DR\nUMAP factorial: direct vs PCA30 input; 2 / 10 / 30 dimensions\nPCA30 control; separate Scanpy legacy UMAP bridge", color="#C97912", fillcolor="#FFF1DA", penwidth=1.8];
 clustering [label="A4  |  Clustering\nKMeans / diagonal GMM (K=23); HDBSCAN (15/15)\nSensitivity: HDBSCAN settings; label-free K selection", color="#C97912", fillcolor="#FFF1DA", penwidth=1.8];
 contrast [shape=diamond, label="At least 2\nnon-noise clusters?"];
 abstain [label="Structural abstention\nTerminal Unknown; no fitted DL\nRetain this outcome in denominators", fillcolor="#F9E8E5"];
 full [label="Full log-normalized genes\nHeld fixed for marker scoring\nA5: explicit HVG-only scoring contrast", color="#C97912", fillcolor="#FFF1DA"];
 score [label="Cluster annotation\nTop 100 Wilcoxon DEGs; legacy marker-density scores\nCM2_glioma_other; fixed panel-to-L1 map; cutoff none\nUnique positive winner, otherwise Undecided"];
 pool [shape=diamond, label="Non-noise\nundecided pool?"];
 noop [label="Empty pool: terminal no-op\nRetain known calls\nNoise remains Unknown", fillcolor="#E8F3ED"];
 classes [shape=diamond, label="At least 2\ntraining classes?"];
 untrainable [label="Structurally untrainable\nRetain known calls; pool Unknown\nNo successful DL claim", fillcolor="#F9E8E5"];
 dl [label="A6  |  DL/refinement\nAll filtered scaled genes; 15 epochs; threshold 0.9\nTrain on non-noise known calls; fill undecided pool\nKnown calls unchanged; Noise never trains", color="#C97912", fillcolor="#FFF1DA", penwidth=1.8];
 terminal [label="Saved terminal DG-scRNA output\nPer-cell calls + lineage + actual DL execution state\nChecksums, parameters, code and SLURM provenance", fillcolor="#D8EEE4", color="#187D5B", penwidth=1.8];
 evaluation [label="Evaluation after fitting\nTerminal strict-L1 concordance + legacy set-valued Lfine score\nSeparate partition ARI / Pair-F1 / FMI / V-measure\nPatient-paired effects; noise, coverage and failure rates", fillcolor="#E8F1F8"];
 reference [label="Author reference labels\n97-sample / 55-patient primary subset\nAll 121 samples also reported", fillcolor="#E8F1F8", style="rounded,filled,dashed"];
 sensitivities [label="Cross-cutting sensitivity controls\nFive fixed seeds; UMAP neighbors / min_dist\nCommon all-gene reference for geometry diagnostics\nMarker-only output shown only as named A6 ablation", color="#C97912", fillcolor="#FFF1DA"];
 ptc [label="Next stage: PTC reproduction gate\nMT+N and TU+T analyzed as two groups\nOriginal R workflow + full original marker roster\nMatch original per-cell tables before further analysis\nNo independent Pu cohort", fillcolor="#F3F6F8", style="rounded,filled,dashed"];
 note [shape=note, label="Orange nodes = ablation points\nBranches preserve the same cells and scoring rules\nTechnical failures are retried and remain NA until resolved\nThis figure describes design; completion counts are in the notebook", fillcolor="white", color="#A4ADB3", fontsize=9];

 input -> counts -> normalize;
 counts -> features [label="VST selection",color="#C97912"];
 normalize -> features [label="scaled geometry input"];
 normalize -> full [label="log-normalized layer"];
 features -> pre;
 pre -> pca [label="yes: UMAP factorial"];
 pre -> dr [label="no",minlen=2];
 pca -> dr;
 dr -> clustering -> contrast;
 contrast -> score [label="yes"];
 contrast -> abstain [label="no"];
 full -> score;
 score -> pool;
 pool -> noop [label="no"];
 pool -> classes [label="yes"];
 classes -> dl [label="yes"];
 classes -> untrainable [label="no"];
 normalize -> dl [style=dashed, label="full scaled genes",color="#187D5B",constraint=false];
 dl -> terminal;
 noop -> terminal;
 untrainable -> terminal;
 abstain -> terminal [constraint=false];
 terminal -> evaluation;
 reference -> evaluation [style=dashed,label="evaluation only",color="#3676A5"];
 evaluation -> ptc [style=dashed,label="GBM verified + notebook delivered"];
 sensitivities -> dr [style=dashed,arrowhead=none,constraint=false,color="#C97912"];
 {rank=same; full; features; sensitivities}
 {rank=same; abstain; contrast}
 {rank=same; noop; pool}
 {rank=same; untrainable; classes}
 {rank=same; reference; evaluation; note}
}
